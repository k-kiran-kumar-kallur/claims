# ---------------------------------------------------------------------------
# Claims AI - environment configuration (copy to .env; never commit .env)
# ---------------------------------------------------------------------------
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO

# Google Gemini via the OpenAI-compatible endpoint (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=                     # server side only; empty => offline deterministic "rules" mode
GEMINI_CHAT_MODEL=gemini-2.5-flash  # default for both tiers
GEMINI_MODEL_FAST=                  # optional override (classification, OCR, extraction)
GEMINI_MODEL_REASONING=             # optional override (summaries, utilization, narrative)
GEMINI_EMBED_MODEL=models/gemini-embedding-001
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_RPM_LIMIT=15                 # free tier; raise on a paid tier
GEMINI_TPM_LIMIT=1000000
LLM_PROVIDER=auto                   # auto | gemini | rules
ALLOW_PHI_TO_LLM=false              # true ONLY on a paid tier / Vertex AI under a BAA
LLM_BODY_RETENTION_DAYS=30

# Storage (local SSD only - never a network share)
DATA_DIR=./data
SECRETS_DIR=./secrets
FILE_ENCRYPTION_KEY=                # Fernet key; REQUIRED in production (python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
JWT_PRIVATE_KEY_PATH=               # RS256 keys; generated into SECRETS_DIR in development
JWT_PUBLIC_KEY_PATH=
COOKIE_SECURE=false                 # true behind HTTPS

# Business thresholds (also editable by admins at runtime)
CONFIDENCE_THRESHOLD_BASELINE=0.95
CONFIDENCE_THRESHOLD_CLASSIFICATION=0.85
CONFIDENCE_THRESHOLD_FACT=0.90
RISK_ESCALATION_THRESHOLD=0.7

# Runtime
RUN_WORKER_IN_PROCESS=true          # false in production: run `python -m app.worker` separately
SEED_DEMO_DATA=true                 # demo users + synthetic sample claim; false in production
CORS_ORIGINS=["http://localhost:5180"]
MAX_UPLOAD_MB=200
# CLAMAV_HOST=clamav                # optional antivirus scanning of uploads
# SMTP_HOST=                        # optional notification emails (no PHI)
